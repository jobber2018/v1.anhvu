<style>
    .dt-length label{display: none!important;}
    .dt-length select{width: 50px;}
    .red{color: red}
    .blue{color: blue}
</style>
<script>
    $(document).ready(function () {
        let tblInventoryHistory=$('#tblInventoryHistory').DataTable({
            info:false,
            paging: true,
            pageLength:<?=\Sulde\Service\Common\Define::ITEM_PAGE_COUNT?>,
            ordering: false,            
            serverSide: true,
            stateSave: false,
            autoWidth: false,
            processing:true,
            searching:false,
            columnDefs: [
                {
                    orderable:false,
                    targets: [0],
                    className:'dt-body-right',
                    width: '10px',                    
                },
                {
                    orderable:false,
                    targets: [1],
                    className:'dt-body-right',
                    width: '90px',                    
                },
                { name: 'change', targets: 3, 
                  createdCell:function (td, cellData, rowData, row, col){
                        if(cellData<0) $(td).addClass('red');
                        else if(cellData>0) $(td).addClass('blue');
                    }                    
                }
            ],
            ajax: {
                url: '<?=$this->url('product-user',['action'=>'inventory-history','id'=>$this->product->getId()])?>',
                type: 'POST',
                beforeSend: function(){
                    $('#tblOrder > tbody').html(
                        '<tr class="odd">' +
                        '<td valign="top" colspan="10" style="font-size: 9pt" class="dataTables_empty">Đang tải dữ liệu&hellip;</td>' +
                        '</tr>'
                    );
                },
                dataSrc: function (json) {
                    let data=[];                    
                    $.each( json.data, function( key, value ) {
                        let dataItem=[];
                        dataItem.push(json.start++);
                        dataItem.push(value.before_change);
                        dataItem.push(value.after_change);
                        dataItem.push(value.changed);
                        dataItem.push(value.created_date);
                        dataItem.push(value.user);
                        dataItem.push(value.note);
                        data.push(dataItem);
                    });
                    return data;                    
                }
            }            
        }).on('click', 'tbody tr', (e) => {
            let classList = e.currentTarget.classList;

            if (classList.contains('tr-selected')) {
                classList.remove('tr-selected');
            }
            else {
                tblInventoryHistory.rows('.tr-selected').nodes().each((row) => row.classList.remove('tr-selected'));
                classList.add('tr-selected');
            }
        });
        
        let tblSellHistory=$('#tblSellHistory').DataTable({
            info:false,
            paging: true,
            pageLength:<?=\Sulde\Service\Common\Define::ITEM_PAGE_COUNT?>,
            ordering: false,            
            serverSide: false,
            stateSave: false,
            autoWidth: false,
            processing:true,
            layout: {
                topStart: null,  // ❌ tắt ô search mặc định
                topEnd: null,    // ❌ tắt length dropdown mặc định
                top: ['search', 'pageLength']
            },
            language: {
                searchPlaceholder: "Tìm kiếm."
            },
            columnDefs: [
                { name:'data', targets: 0, visible: false},
                { name: 'status', targets: 2, 
                  createdCell:function (td, cellData, rowData, row, col){
                        let cls='label-success';
                        let orderStatusId=rowData[0].status_id;
                        if(orderStatusId==0) 
                            cls='label-danger';
                        else if(orderStatusId==111 || orderStatusId==11 || orderStatusId==1)
                            cls='label-warning';
                        else if(orderStatusId==31)
                            cls='label-default';

                        $(td).html('<small class="label ' + cls + '">' + rowData[0].status_label + '</small>');                        
                    }                    
                },                
                { name: 'name', targets: 3, className:'dt-body-left title',
                   createdCell:function (td, cellData, rowData, row, col){
                        let url='<?=$this->url('sell-admin', ['action' => 'detail-order', 'id' => '__id__'])?>';
                        $(td).html('<a href="' + url.replace('__id__', rowData[0].order_id) + '">' + cellData + '</a>');
                    }                    
                }
            ],
            ajax: {
                url: '<?=$this->url('product-user',['action'=>'sell-history','id'=>$this->product->getId()])?>',
                type: 'POST',
                dataSrc: function (json) {
                    //console.log('Sell History JSON:', json);
                    let data=[]; 
                    let i=1;                   
                    $.each( json.data, function( key, value ) {                        
                        let dataItem=[];
                            dataItem.push(value);
                            dataItem.push(i++);
                            dataItem.push(value.status_id);
                            dataItem.push(value.grocery_name);
                            dataItem.push(value.created_date);
                            dataItem.push(value.price);
                            dataItem.push(value.qty+' '+value.unit_name);
                            dataItem.push(value.amount);
                            
                            data.push(dataItem);                        
                    });
                    return data;                    
                }
            },
            initComplete: function(settings, json) {
                // Group data by month from json response
                let chartData = {};
                let unitName = 'Thùng';
                let packUnit=<?=$this->product->getBoxUnit()?>;                
                if(json.data && json.data.length > 0) {                    
                    $.each(json.data, function(key, value) {
                        // Parse created_date to extract month/year (format: d/m/Y H:i:s)
                        let dateStr = value.created_date.trim();
                        // Split by space to separate date and time
                        let dateTimeParts = dateStr.split(' ');
                        let datePart = dateTimeParts[0]; // e.g., "5/2/2026"
                        let parts = datePart.split('/');
                        let monthYear = '';
                        
                        if(parts.length >= 2) {
                            // Format: m/yyyy (parts[1] = month, parts[2] = year)
                            monthYear = parts[1] + '/' + parts[2];
                        }
                        
                        if(monthYear) {
                            if(!chartData[monthYear]) {
                                chartData[monthYear] = 0;
                            }
                            
                            let qty = parseInt(value.base_qty) || 0;
                            chartData[monthYear] += qty;                            
                        }
                    });
                    //console.log('Grouped Chart Data:', chartData);
                    // Convert to Morris format - ensure ONE entry per month
                    let morrisData = [];
                    let months = Object.keys(chartData).sort(function(a, b) {
                        let [monthA, yearA] = a.split('/').map(function(v) { return parseInt(v, 10) || 0; });
                        let [monthB, yearB] = b.split('/').map(function(v) { return parseInt(v, 10) || 0; });
                        if (yearA !== yearB) {
                            return yearB - yearA;
                        }
                        return monthB - monthA;
                    });
                    
                    $.each(months, function(idx, month) {
                        morrisData.push({ 
                            y: month, 
                            qty: (chartData[month]/(packUnit>0?packUnit:1)).toFixed(1), 
                            unit: unitName 
                        });
                    });
                    
                    //console.log('Morris Data:', morrisData);
                    
                    if(morrisData.length > 0) {
                        // Clear container before rendering
                        $('#morris-bar-grocery').empty();
                        
                        Morris.Bar({
                            element: 'morris-bar-grocery',
                            data: morrisData,
                            xkey: 'y',
                            ykeys: ['qty'],
                            labels: ['Số lượng bán'],
                            barColors: ['#0f85d9'],
                            hoverCallback: function (index, options, content, row) {
                                var hover = "<div class='morris-hover-row-label'>Tháng "+row.y+"</div><div class='morris-hover-point'><p style='color:#0f85d9; padding-bottom: 5px; margin-bottom:0px; padding-top: 10px'>Số lượng: "+row.qty+' '+unitName+"</p></div>";
                                return hover;
                            },
                        });
                    }
                }
            }
        }).on('click', 'tbody tr', (e) => {
            let classList = e.currentTarget.classList;

            if (classList.contains('tr-selected')) {
                classList.remove('tr-selected');
            }
            else {
                tblSellHistory.rows('.tr-selected').nodes().each((row) => row.classList.remove('tr-selected'));
                classList.add('tr-selected');
            }
        });
        

        let tblByHistory=$('#tblByHistory').DataTable({
            info:false,
            paging: true,
            pageLength:<?=\Sulde\Service\Common\Define::ITEM_PAGE_COUNT?>,
            ordering: false,            
            serverSide: true,
            stateSave: false,
            autoWidth: false,
            processing:true,
            searching:false,
            columnDefs: [
                { name:'order_id', targets: 0, visible: false},                                
                { name: 'status', targets: 1, className:'title', width: '120px',
                  createdCell:function (td, cellData, rowData, row, col){                            
                        if(cellData==0){
                            let url='<?=$this->url('werehouse-admin', ['action' => 'edit-draft', 'id' => '__id__'])?>';
                            $(td).addClass('red');
                            $(td).html('<a href="' + url.replace('__id__', rowData[0]) + '"><span class="fa fa-edit"></span> Sửa bản nháp</a>');
                        }
                        else{
                            let url='<?=$this->url('werehouse-admin',['action'=>'view','id'=>'__id__'])?>';
                            $(td).addClass('blue');
                            $(td).html('<a href="' + url.replace('__id__', rowData[0]) + '"><span class="fa fa-check-circle"></span> Đã nhập kho</a>');
                        };                        
                    }                    
                }
            ],
            ajax: {
                url: '<?=$this->url('product-user',['action'=>'by-history','id'=>$this->product->getId()])?>',
                type: 'POST',
                beforeSend: function(){
                    $('#tblOrder > tbody').html(
                        '<tr class="odd">' +
                        '<td valign="top" colspan="10" style="font-size: 9pt" class="dataTables_empty">Đang tải dữ liệu&hellip;</td>' +
                        '</tr>'
                    );
                },
                dataSrc: function (json) {
                    let data=[];                    
                    $.each( json.data, function( key, value ) {
                        let dataItem=[];
                        //dataItem.push(value.order_id);
                        dataItem.push(json.start++);                        
                        dataItem.push(value.status);
                        dataItem.push(value.supplier_name);
                        dataItem.push(value.created_date);
                        dataItem.push(value.price);
                        dataItem.push(value.qty);
                        dataItem.push(value.box_unit);
                        dataItem.push(value.total_amount);
                        data.push(dataItem);
                    });
                    return data;                    
                }
            }            
        }).on('click', 'tbody tr', (e) => {
            let classList = e.currentTarget.classList;

            if (classList.contains('tr-selected')) {
                classList.remove('tr-selected');
            }
            else {
                tblByHistory.rows('.tr-selected').nodes().each((row) => row.classList.remove('tr-selected'));
                classList.add('tr-selected');
            }
        }); 

        let tblActivity=$('#tblActivity').DataTable({
            info:false,
            paging: true,
            pageLength:<?=\Sulde\Service\Common\Define::ITEM_PAGE_COUNT?>,
            ordering: false,            
            serverSide: true,
            stateSave: false,
            autoWidth: false,
            processing:true,
            searching:false,
            columnDefs: [
                {
                    orderable:false,
                    targets: [0],
                    className:'dt-body-right',
                    width: '10px',                    
                },
                {
                    orderable:false,
                    targets: [1],
                    className:'dt-body-right',
                    width: '90px',                    
                },
                { name: 'change', targets: 1, 
                  createdCell:function (td, cellData, rowData, row, col){
                        if(cellData<0) $(td).addClass('red');
                        else if(cellData>0) $(td).addClass('blue');
                    }                    
                }
            ],
            ajax: {
                url: '<?=$this->url('product-user',['action'=>'activity','id'=>$this->product->getId()])?>',
                type: 'POST',
                beforeSend: function(){
                    $('#tblOrder > tbody').html(
                        '<tr class="odd">' +
                        '<td valign="top" colspan="10" style="font-size: 9pt" class="dataTables_empty">Đang tải dữ liệu&hellip;</td>' +
                        '</tr>'
                    );
                },
                dataSrc: function (json) {
                    let data=[];                    
                    $.each( json.data, function( key, value ) {
                        let dataItem=[];
                        dataItem.push(json.start++);
                        dataItem.push(value.change);
                        dataItem.push(value.created_date);
                        dataItem.push(value.user);
                        dataItem.push(value.note);
                        data.push(dataItem);
                    });
                    return data;                    
                }
            }            
        }).on('click', 'tbody tr', (e) => {
            let classList = e.currentTarget.classList;

            if (classList.contains('tr-selected')) {
                classList.remove('tr-selected');
            }
            else {
                tblActivity.rows('.tr-selected').nodes().each((row) => row.classList.remove('tr-selected'));
                classList.add('tr-selected');
            }
        });        

    });
</script>