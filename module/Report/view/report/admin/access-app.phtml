    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    ...
                </div>
                <div class="panel-body">
                    <table class="table table-hover" id="tblProduct">
                        <thead>
                        <tr>
                            <th></th>
                            <th>No.</th>
                            <th>Tên khách hàng</th>
                            <th>Số Zalo</th>
                            <th>Tên Zalo</th>
                            <th>Avatar</th>
                            <th>Truy cập lần đầu</th>
                            <th>Truy cập gần nhất</th>
                            <th>Zalo ID</th>
                        </tr>
                        </thead>
