<script>
    $(document).ready(function () {
        $( ".directions" ).click(function() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    function(position){
                        var currentLocal = position.coords.latitude+','+ position.coords.longitude;
                        var groceryLocal = '<?=$this->sellOrder->getGrocery()->getLat().','.$this->sellOrder->getGrocery()->getLng()?>';
                        var url = 'https://www.google.com/maps/dir/?api=1&origin='+currentLocal+'&destination='+groceryLocal;
                        window.location.href =url;
                    },
                    function(error) {
                        alert('<?=$this->translate("Turn on location services to use this function.")?>');
                    }
                );
            }
        });
    });

    document.addEventListener('DOMContentLoaded', function() {
        // Hàm chuẩn hóa tiếng Việt: xóa dấu, chuyển chữ thường để tìm kiếm chính xác
        function cleanText(str) {
            if (!str) return '';
            str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, "a");
            str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, "e");
            str = str.replace(/ì|í|ị|ỉ|ĩ/g, "i");
            str = str.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, "o");
            str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, "u");
            str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, "y");
            str = str.replace(/đ/g, "d");
            str = str.replace(/À|Á|Ạ|Ả|Ã|Â|Ầ|Ấ|Ậ|Ẩ|Ẫ|Ă|Ằ|Ắ|Ặ|Ẳ|Ẵ/g, "A");
            str = str.replace(/È|É|Ẹ|Ẻ|Ẽ|Ê|Ề|Ế|Ệ|Ể|Ễ/g, "E");
            str = str.replace(/Ì|Í|Ị|Ỉ|Ĩ/g, "I");
            str = str.replace(/Ò|Ó|Ọ|Ỏ|Õ|Ô|Ồ|Ố|Ộ|Ổ|Ỗ|Ơ|Ờ|Ớ|Ợ|Ở|Ỡ/g, "O");
            str = str.replace(/Ù|Ú|Ụ|Ủ|Ũ|Ư|Ừ|Ứ|Ự|Ử|Ữ/g, "U");
            str = str.replace(/Y|Ý|Ỵ|Ỷ|Ỹ/g, "Y");
            str = str.replace(/Đ/g, "D");
            return str.toLowerCase().trim();
        }

        const searchInput = document.getElementById('productSearchInput');
        const noResultMsg = document.getElementById('noProductMsg');

        // Lắng nghe sự kiện người dùng gõ vào ô tìm kiếm
        searchInput.addEventListener('input', function(e) {
            const keyword = cleanText(e.target.value);
            // Chọn tất cả các phần tử li sản phẩm nằm trong #productList
            const products = document.querySelectorAll('#productList .list-group-item');
            let hasMatch = false;

            products.forEach(function(product) {
                // Lấy thẻ h5 chứa thông tin tiêu đề sản phẩm
                const titleElement = product.querySelector('.title');

                if (titleElement) {
                    const productText = cleanText(titleElement.textContent);
                    // So khớp từ khóa với chuỗi text của sản phẩm
                    if (productText.includes(keyword)) {
                        product.style.setProperty('display', 'block', 'important'); // Hiện sản phẩm
                        hasMatch = true;
                    } else {
                        product.style.setProperty('display', 'none', 'important');  // Ẩn sản phẩm
                    }
                }
            });

            // Hiển thị hoặc ẩn thông báo "Không tìm thấy"
            if (hasMatch || keyword === '') {
                noResultMsg.style.display = 'none';
            } else {
                noResultMsg.style.display = 'block';
            }
        });
    });
</script>